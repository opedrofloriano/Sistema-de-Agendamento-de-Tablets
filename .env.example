# Copie para .env e preencha. O servidor lê este arquivo ao iniciar.

# Ambiente: production em produção.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Endereço público, exatamente como os professores acessam (sem barra no fim).
BASE_URL=https://tablets.suaescola.edu.br

# Banco de dados (arquivo SQLite). Inclua esta pasta no backup.
DATABASE_PATH=data/agendamento.db

# Regras da escola: acervo, unidades, horários de aula.
SCHOOL_CONFIG=config/escola.json

# Duração da sessão, em horas.
SESSION_HOURS=12

# Quem pode exibir o sistema dentro de um iframe. Ex.: 'self' https://portal.suaescola.edu.br
FRAME_ANCESTORS='self'

# --- Login Microsoft (Entra ID) ---
AUTH_MODE=entra
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=troque-pelo-segredo

# Coordenação (basta uma das três formas):
# 1) App role do aplicativo (recomendado). Valor do papel criado no Entra:
ENTRA_COORDINATOR_APP_ROLE=Coordenacao
# 2) Ids de grupos do Entra, separados por vírgula (exige a declaração "groups" no token):
ENTRA_COORDINATOR_GROUP_IDS=
# 3) E-mails, separados por vírgula:
COORDINATOR_EMAILS=

# Opcional: só deixa entrar quem estiver nestes grupos (ids separados por vírgula).
# Alternativa recomendada: "Atribuição obrigatória" no aplicativo empresarial do Entra.
ENTRA_ALLOWED_GROUP_IDS=
